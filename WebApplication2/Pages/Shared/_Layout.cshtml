@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Витрина товаров</title>

    <!-- Antiforgery-токен для AJAX-запросов -->
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <!-- CSS -->
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <header>
        <!-- ===== NAVBAR ===== -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <!-- Логотип слева -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/img/logo.svg" alt="Логотип" width="32" height="32" class="me-2" />
                    <span class="fw-bold">Витрина</span>
                </a>

                <!-- Кнопка-бургер для мобильных -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Сворачиваемое меню -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Левая группа ссылок -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Catalog/Index">Каталог</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Cart/Index">
                                Корзина
                                <span class="badge bg-danger rounded-pill" id="cartBadge">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Admin/Index">Админ</a>
                        </li>
                    </ul>

                    <!-- Правая группа: кнопка "Войти" -->
                    <div class="d-flex">
                        <a class="btn btn-outline-light" href="#">Войти</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-3">
            &copy; 2025 - Витрина товаров
        </div>
    </footer>

    <!-- ===== Контейнер для всплывающих уведомлений (тостов) ===== -->
    <!-- ===== Bootstrap Toast для уведомлений ===== -->
    <div class="position-fixed end-0 p-3" style="z-index: 1080; top: 4.5rem;">
        <div id="cartToast"
             class="toast align-items-center text-white bg-success border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="cartToastText">
                    Товар добавлен в корзину
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Закрыть"></button>
            </div>
        </div>
    </div>

    <!-- ===== Скрипты ===== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <environment include="Development">
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>

    <!-- Сюда страницы могут добавлять свои скрипты через Scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>