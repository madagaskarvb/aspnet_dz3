@page
@model WebApplication2.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Корзина";
}

<div class="container my-4">

    <h1 class="h3 page-title">Корзина</h1>

    <!-- ===== ALERT ===== -->
    @if (!string.IsNullOrEmpty(Model.FlashMessage))
    {
        var alertClass = Model.FlashType == "success" ? "alert-success" : "alert-warning";
        var icon = Model.FlashType == "success" ? "✅" : "⚠️";

        <div class="alert @alertClass alert-dismissible fade show auto-dismiss" role="alert">
            <span class="me-1">@icon</span>
            @Model.FlashMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
        </div>
    }

    <!-- ===== СОДЕРЖИМОЕ КОРЗИНЫ ===== -->
    @if (Model.Items.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <div class="fs-1">🛒</div>
            <p class="mt-2">Здесь пока ничего нет.</p>
        </div>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@item.Name</span>
                    <span class="fw-bold">@item.Price.ToString("N0") ₽</span>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                <span class="fw-bold">Итого:</span>
                <span class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N0") ₽</span>
            </li>
        </ul>
    }

    <!-- ===== КНОПКИ ===== -->
    <div class="d-flex flex-wrap gap-2">
        <form method="post" asp-page-handler="Add">
            <button type="submit" class="btn btn-primary">
                🛒 Добавить товар
            </button>
        </form>

        @if (Model.Items.Count > 0)
        {
            <!-- Кнопка, открывающая модалку -->
            <button type="button"
                    class="btn btn-order"
                    data-bs-toggle="modal"
                    data-bs-target="#confirmOrderModal">
                ✅ Оформить заказ
            </button>

            <form method="post" asp-page-handler="Clear">
                <button type="submit" class="btn btn-outline-danger">
                    Очистить корзину
                </button>
            </form>
        }
    </div>

</div>

<!-- ===== МОДАЛЬНОЕ ОКНО ПОДТВЕРЖДЕНИЯ ===== -->
@if (Model.Items.Count > 0)
{
    <div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-labelledby="confirmOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="confirmOrderModalLabel">Подтверждение заказа</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Вы уверены, что хотите оформить заказ на сумму
                        <strong class="text-primary">@Model.TotalAmount.ToString("N0") ₽</strong>?
                    </p>

                    <ul class="list-group mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@item.Name</span>
                                <span class="fw-bold">@item.Price.ToString("N0") ₽</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Отмена
                    </button>

                    <form method="post" asp-page-handler="Confirm" class="m-0">
                        <button type="submit" class="btn btn-primary">
                            Подтвердить
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
}